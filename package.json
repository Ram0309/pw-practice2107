{
  "name": "ai-qa-agent-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous multi-agent AI QA framework (TypeScript + LangGraph.js + Playwright) for the Tricentis Demo Web Shop",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=ui --project=api",
    "test:smoke": "playwright test --grep @smoke --project=ui --project=api",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:framework": "playwright test --project=framework",
    "test:generated": "playwright test --project=generated",
    "report": "playwright show-report reports/playwright-html",
    "agent": "tsx src/cli.ts",
    "agent:requirement": "tsx src/cli.ts requirement",
    "agent:knowledge": "tsx src/cli.ts knowledge",
    "agent:design": "tsx src/cli.ts design",
    "agent:inspect": "tsx src/cli.ts inspect",
    "agent:heal": "tsx src/cli.ts heal",
    "agent:api": "tsx src/cli.ts api",
    "agent:full": "tsx src/cli.ts full",
    "agent:providers": "tsx src/cli.ts providers",
    "agent:validate": "tsx src/cli.ts validate",
    "agent:execute": "tsx src/cli.ts execute"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.1",
    "@langchain/core": "1.3.5",
    "@langchain/google-genai": "2.3.5",
    "@langchain/langgraph": "1.7.2",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.8.2",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  }
}
