# ─────────────────────────────────────────────────────────────
# AI-QA-AGENT-FRAMEWORK configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# ── Model provider (model-independent) ──────────────────────
# mock | openai | azure-openai | anthropic | google | ollama
# "mock" runs every agent with its deterministic offline logic: no API key, no cost.
LLM_PROVIDER=mock
# Leave empty to use the provider default (see src/llm/providers.ts)
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=60000
# If the LLM call fails or returns invalid output, fall back to the agent's offline logic
LLM_FALLBACK_TO_OFFLINE=true
# Optional per-agent routing: agent=provider:model;agent=provider:model
# e.g. scriptGenerator=anthropic:claude-sonnet-5-5;healing=ollama:llama3.1;reporting=mock
LLM_AGENT_ROUTES=

OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, vLLM ...)
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_INSTANCE_NAME=
AZURE_OPENAI_API_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Application under test ──────────────────────────────────
APP_BASE_URL=https://demowebshop.tricentis.com
HEADLESS=true

# ── Autonomy and safety controls ────────────────────────────
# Generated scripts only run when this is true AND the Code Validator approved them
ALLOW_GENERATED_TEST_EXECUTION=false
# suggest        = record validated repairs only (human applies them)
# auto-generated = apply validated repairs automatically, but ONLY to files in generated-tests/
HEALING_MODE=suggest
MAX_GENERATED_SCRIPTS=3
MAX_GENERATION_ATTEMPTS=2
MAX_TEST_RUN_SECONDS=300

# ── Logging ─────────────────────────────────────────────────
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
